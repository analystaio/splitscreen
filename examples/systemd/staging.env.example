# ~/.config/splitscreen/staging.env  (mode 0600)
#
# No secrets here: the enrollment token lives in its own file, and every other
# credential lives on the gateway.
SPLITSCREEN_GATEWAY=wss://10.0.0.5:8443
SPLITSCREEN_GATEWAY_FINGERPRINT=sha256:30a6599447c9a8515aebeebbb9f7920d37a864f79182091e1ff2642967ff2569
SPLITSCREEN_CWD=/var/www/app
SPLITSCREEN_IDLE=30m

# Optional: keep what the agent accumulates (per-project memory, session
# transcripts, skills it creates, CLAUDE.local.md notes) on persistent disk, so
# it survives bundle pushes and reboots. Unset, everything stays on tmpfs.
#SPLITSCREEN_STATE_DIR=/home/ubuntu/.local/state/splitscreen/staging
